# LLM Backend — uncomment the one you want to use
# LLM_BACKEND=ollama     # default, needs Ollama running locally
# LLM_BACKEND=gemini     # Google Gemini API (free tier: 15 req/min, 1M tokens/day)
# LLM_BACKEND=groq       # Groq API (fast: 500-800 tok/s, generous free tier)

# --- Gemini ---
# Get key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash        # fast + free; or gemini-2.5-pro for quality

# --- Groq ---
# Get key at: https://console.groq.com/keys
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile   # best tool use; or moonshotai/kimi-k2-instruct

# --- Ollama (local) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_GENERATE_MODEL=gemma4:31b-cloud
# OLLAMA_EMBED_MODEL=nomic-embed-text
